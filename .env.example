# Which LLM backend to use: "ollama" (local, default) or "api" (hosted, not implemented yet)
LLM_PROVIDER=ollama

# Must exactly match a model name shown by `ollama list` (run `ollama pull llama3.2` first),
# otherwise Ollama returns 404.
OLLAMA_MODEL=llama3.2

# Get a key from newsapi.org. Never commit your real .env file.
NEWSAPI_KEY=your_actual_key_here
